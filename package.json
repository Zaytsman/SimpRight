{
  "name": "simpright",
  "version": "0.1.0",
  "private": true,
  "description": "Automated Test Framework with TypeScript + Playwright",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "validate:scenarios": "node scripts/validate-scenarios.mts",
    "inspect:ui": "node scripts/inspect-ui.mts",
    "test-cases:build": "node scripts/build-test-cases.mts",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.5",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@zaytsman/playwright-api-coverage": "^0.4.0"
  }
}
