{
  "name": "simpright",
  "version": "0.1.0",
  "private": true,
  "description": "Automated Test Framework with TypeScript + Playwright",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "validate:scenarios": "simpright-scenarios validate",
    "check:step-titles": "simpright-scenarios check-step-titles",
    "doctor": "simpright doctor",
    "inspect:ui": "node scripts/inspect-ui.mts",
    "test-cases:build": "simpright-portal build-test-cases",
    "bugs:build": "simpright-portal build-bugs",
    "portal:build": "simpright-portal build-config",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@simpright/portal": "0.1.0",
    "@simpright/scenarios": "0.1.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "simpright": "0.1.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@zaytsman/playwright-api-coverage": "^0.5.0"
  }
}
